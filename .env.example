# Resend is the primary transport for the contact form.
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=paulmichaelomega@gmail.com

# Must be a verified sender in your Resend account.
CONTACT_FROM_EMAIL=

# SMTP fallback. Only used when RESEND_API_KEY is not set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Public origin of the site. Used for metadataBase, Open Graph, sitemap, and robots.
# Local default is http://localhost:3000
NEXT_PUBLIC_SITE_URL=
